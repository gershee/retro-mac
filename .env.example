# Environment overrides (all optional). Retro Mac reads the process environment; it does not load this file
# itself. Use it with launchd/systemd, `set -a; . ./.env; set +a`, or as a reference.

RETRO_MAC_PORT=8787                 # display server port (always 127.0.0.1)
RETRO_MAC_DEMO=0                    # 1 = demo mode (sample data, no Hermes)
RETRO_MAC_CONFIG=./config.toml      # alternate config file
RETRO_MAC_DATA=./data               # settings.json, attention.json, logs, kiosk Chrome profile
RETRO_MAC_VOICES=./voices           # Piper .onnx voices
RETRO_MAC_STUCK_AFTER=180           # seconds of WORKING with no progress before the "still trying" banner
RETRO_MAC_HERMES_PYTHON=            # optional LIMITS window: Hermes venv python ([limits].python in config.toml)
RETRO_MAC_SCREEN_NAME=guest         # name on the optional AOL skin ([aol].screen_name): 3-16 letters/digits/spaces

# Hermes plugin (set in the environment of the Hermes gateway / TUI)
RETRO_MAC_BASE=http://127.0.0.1:8787
RETRO_MAC_USER_NAME=The user        # how the voice rules refer to you ("Sam said this out loud...")
RETRO_MAC_DELEGATE_HINT=            # e.g. "a delegate_task subagent" for long voice jobs

# Voice loop
HERMES_HOME=~/.hermes
HERMES_AGENT_DIR=~/.hermes/hermes-agent
HERMES_BIN=hermes
RETRO_MAC_VOICE_SESSION=hermes-voice
RETRO_MAC_KWS_MODEL=./models/sherpa-onnx-kws-zipformer-gigaspeech-3.3M-2024-01-01
WHISPER_CLI=whisper-cli
